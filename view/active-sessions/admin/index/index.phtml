<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Laminas\Form\Form $form
 * @var array $rows      [['hash', 'mine', 'session' => [id, user_id, modified], 'seen' => row|null]]
 * @var array $users     [id => [name, email, role, is_active]]
 * @var array $lastSignIn [user id => [ip, happened_at]]
 * @var array $ended
 * @var int $lifetime   seconds a session lives unused (gc_maxlifetime)
 * @var array $limits    [short, long, roles]: how long a sign-in may last, by role (Limits; 0 = no limit)
 * @var \DateTimeZone $tz
 * @var string $otherHandler
 * @var array $choices   [user id => '7d'|'30d'|'180d'|'max']: people with their own time (0.3)
 * @var int $ceiling     the longest the server allows (Limits::ceiling)
 * @var array $persons   users a time can be given to
 * @var array $log       the changes of those, newest first
 */
use ActiveSessions\Stdlib\Device;
use ActiveSessions\Stdlib\Limits;

$h = fn($s) => $this->escapeHtml((string) $s);
$this->htmlElement('body')->appendAttribute('class', 'active-sessions');
echo $this->pageTitle('Signed-in sessions');
$csrf = $this->formHidden($form->get('active_sessions_csrf'));
$at = function (int $t) use ($tz): string {
    if ($t <= 0) {
        return '';
    }
    return (new \DateTime('@' . $t))->setTimezone($tz)->format('j M Y, H:i');
};
$ago = function (int $t): string {
    $s = time() - $t;
    if ($s < 90) { return 'just now'; }
    if ($s < 5400) { return round($s / 60) . ' minutes ago'; }
    if ($s < 129600) { return round($s / 3600) . ' hours ago'; }
    return round($s / 86400) . ' days ago';
};
$who = function (int $uid) use ($users, $h): string {
    $u = $users[$uid] ?? null;
    if (!$u) {
        return '<span class="as-mute">user #' . $uid . ' (deleted)</span>';
    }
    return '<strong>' . $h($u['name']) . '</strong><br><span class="as-mute">' . $h($u['email']) . ' · ' . $h(str_replace('_', ' ', $u['role'])) . ($u['is_active'] ? '' : ' · inactive') . '</span>';
};
$people = count(array_unique(array_map(fn($r) => $r['session']['user_id'], $rows)));
$days = round($lifetime / 86400, 1);
/* the rule, as set: "A sign-in lasts 12 hours from when it began (global admin: 7 days), and
   or after 30 days unused if that comes first." */
$roleNames = implode(', ', array_map(fn($x) => str_replace('_', ' ', $x), $limits['roles']));
$longPart = $limits['roles'] && $limits['long'] !== $limits['short']
    ? ' (' . $roleNames . ': ' . ($limits['long'] > 0 ? Limits::words($limits['long']) : 'no time limit') . ')' : '';
if ($limits['short'] <= 0 && $longPart === '') {
    $rule = 'A sign-in ends by itself after ' . $days . ' days unused.';
} else {
    $rule = ($limits['short'] > 0 ? 'A sign-in lasts ' . Limits::words($limits['short']) . ' from when it began' : 'A sign-in has no time limit')
        . $longPart . ', or after ' . $days . ' days unused if that comes first.';
}
?>
<style>
.active-sessions{--as-line:#e3e5e8;--as-mute:#6b7280;--as-me:#e8f1fb;--as-meline:#1f5f99;--as-bad:#a3311f}
.as-bar{border:1px solid var(--as-line);border-radius:10px;padding:12px 16px;margin:0 0 14px;background:#f7fafc}
.as-bar strong{font-size:18px}
.as-mute{color:var(--as-mute);font-size:12.5px}
.as-table{width:100%;border-collapse:collapse;background:#fff}
.as-table th{text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.03em;color:var(--as-mute);border-bottom:2px solid var(--as-line);padding:8px}
.as-table td{border-bottom:1px solid var(--as-line);padding:9px 8px;vertical-align:top;font-size:14px}
.as-table tr.me td{background:var(--as-me)}
.as-table tr.me td:first-child{box-shadow:inset 4px 0 0 var(--as-meline)}
.as-tag{display:inline-block;border-radius:999px;padding:1px 8px;font-size:11.5px;font-weight:600;background:var(--as-meline);color:#fff;margin-left:4px}
.as-table code{font-size:13px}
.as-end button{background:#fff;color:var(--as-bad);border:1px solid var(--as-bad);border-radius:6px;padding:4px 10px;cursor:pointer}
.as-end button:hover{background:var(--as-bad);color:#fff}
.as-box{margin:24px 0 0}
.as-keep{display:inline-block;border-radius:999px;padding:1px 8px;font-size:11.5px;font-weight:600;background:#1d6b3a;color:#fff;margin-left:4px}
.as-own{display:inline-block;border-radius:999px;padding:1px 8px;font-size:11.5px;font-weight:600;background:#eef2f6;color:#333;margin-left:4px}
.as-act{display:flex;flex-direction:column;gap:6px;align-items:flex-start}
.as-act form{margin:0}
.as-act .as-k button{background:#fff;color:#1d6b3a;border:1px solid #1d6b3a;border-radius:6px;padding:4px 10px;cursor:pointer}
.as-act .as-k button:hover{background:#1d6b3a;color:#fff}
.as-person{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.as-person select{max-width:100%}
.as-box h3{margin:0 0 8px}
@media (max-width:800px){
  .as-table thead{display:none}
  .as-table tr{display:block;border:1px solid var(--as-line);border-radius:8px;margin:0 0 10px}
  .as-table td{display:block;border:0;padding:4px 10px}
  .as-table td[data-l]::before{content:attr(data-l) ": ";color:var(--as-mute);font-size:12px}
}
</style>

<div class="as-bar">
  <strong><?= count($rows) ?> sign-in<?= count($rows) === 1 ? '' : 's' ?></strong>
  by <?= $people ?> <?= $people === 1 ? 'person' : 'people' ?> still work.
  <span class="as-mute"><?= $h($rule) ?> Ending one here sends that browser to the login page on its next click.</span>
  <?php if ($otherHandler): ?>
  <div class="as-mute"><strong>Note:</strong> this site keeps sessions with <?= $h($otherHandler) ?>, not in the database, so this list cannot see them.</div>
  <?php endif; ?>
</div>

<table class="as-table">
  <thead><tr><th>Who</th><th>Device</th><th>Address</th><th>Signed in</th><th>Last used</th><th></th></tr></thead>
  <tbody>
  <?php foreach ($rows as $r):
      $s = $r['session'];
      $seen = $r['seen'];
      $uid = (int) $s['user_id'];
      $ua = $seen ? (string) $seen['user_agent'] : '';
      /* session.modified is written as a request ENDS, so for the request reading it the
         list's own row is one request behind; what Recorder noted is newer then. */
      $last = max((int) $s['modified'], $seen ? (int) $seen['last_seen'] : 0);
      /* when it ends: its time limit (from since) or unused, whichever comes first */
      $since = $seen ? (int) ($seen['since'] ?? 0) : 0;
      $limit = (int) ($r['limit'] ?? 0);
      $endUnused = $last + $lifetime;
      if ($r['kept'] && $since > 0) {
          $ends = 'kept: ends ' . $at(min($since + $limit, $endUnused)) . ' (' . Limits::words($limit) . ' from sign-in, the longest the server allows, or unused)';
      } elseif ($limit > 0 && $since > 0 && $since + $limit <= $endUnused) {
          $ends = 'ends ' . $at($since + $limit) . ' (' . Limits::words($limit) . ' from sign-in)';
      } elseif ($limit > 0 && $since <= 0) {
          $ends = 'time limit (' . Limits::words($limit) . ') starts at its next use';
      } else {
          $ends = 'ends ' . $at($endUnused) . ' if unused';
      }
  ?>
    <tr class="<?= $r['mine'] ? 'me' : '' ?>" data-sid="<?= $h($r['hash']) ?>">
      <td data-l="Who"><?= $who($uid) ?><?= $r['mine'] ? ' <span class="as-tag">you, this browser</span>' : '' ?><?= $r['kept'] ? ' <span class="as-keep">kept on this device</span>' : '' ?><?= !$r['kept'] && ($r['why'] ?? '') === 'person' ? ' <span class="as-own">own time: ' . $h(Limits::choiceWords($choices[$uid] ?? null, $ceiling)) . '</span>' : '' ?></td>
      <td data-l="Device">
        <?php if ($seen && $ua !== ''): ?>
          <span title="<?= $h($ua) ?>"><?= $h(Device::describe($ua)) ?></span>
        <?php elseif ($seen): ?>
          <span class="as-mute">the browser sent no name</span>
        <?php else: ?>
          <span class="as-mute">not seen yet</span>
        <?php endif; ?>
      </td>
      <td data-l="Address">
        <?php if ($seen && $seen['ip'] !== ''): ?>
          <code><?= $h($seen['ip']) ?></code>
          <?php if ($seen['first_ip'] !== '' && $seen['first_ip'] !== $seen['ip']): ?>
            <br><span class="as-mute">first seen from <code><?= $h($seen['first_ip']) ?></code></span>
          <?php endif; ?>
        <?php elseif (isset($lastSignIn[$uid])): ?>
          <span class="as-mute">not seen yet · this person last signed in from <code><?= $h($lastSignIn[$uid]['ip']) ?></code></span>
        <?php else: ?>
          <span class="as-mute">not seen yet</span>
        <?php endif; ?>
      </td>
      <td data-l="Signed in">
        <?php if ($seen && (int) $seen['first_seen'] > 0): ?>
          <?= $h($at((int) $seen['first_seen'])) ?>
        <?php else: ?>
          <span class="as-mute">before this list began recording</span>
        <?php endif; ?>
      </td>
      <td data-l="Last used">
        <?= $h($ago($last)) ?><br>
        <span class="as-mute"><?= $h($at($last)) ?> · <?= $h($ends) ?></span>
      </td>
      <td class="as-act">
        <form class="as-k" method="post" action="<?= $h($this->url('admin/active-sessions', ['action' => 'keep'])) ?>">
          <?= $csrf ?>
          <input type="hidden" name="sid" value="<?= $h($r['hash']) ?>">
          <input type="hidden" name="on" value="<?= $r['kept'] ? '0' : '1' ?>">
          <button type="submit" title="<?= $h($r['kept'] ? 'This device follows the rule again' : 'This device only, for the longest the server allows (' . Limits::words($ceiling) . ' from its sign-in); other devices of this person follow the rule') ?>"><?= $r['kept'] ? 'Stop keeping' : 'Keep this device signed in longest' ?></button>
        </form>
        <?php if ($r['mine']): ?>
          <span class="as-mute">To end this one, use Log out.</span>
        <?php else: ?>
          <form class="as-end" method="post" action="<?= $h($this->url('admin/active-sessions', ['action' => 'end'])) ?>"
                onsubmit="return confirm(<?= $h(json_encode('Sign out ' . ($users[$uid]['name'] ?? 'this person') . ' on ' . ($ua !== '' ? Device::describe($ua) : 'this sign-in') . '?')) ?>)">
            <?= $csrf ?>
            <input type="hidden" name="sid" value="<?= $h($r['hash']) ?>">
            <button type="submit">Sign out</button>
          </form>
        <?php endif; ?>
      </td>
    </tr>
  <?php endforeach; ?>
  </tbody>
</table>

<div class="as-box">
  <h3>One person's own time</h3>
  <p class="as-mute">Instead of their role's: for every device of theirs, from their next click. The longest the server allows is <strong><?= $h(Limits::words($ceiling)) ?></strong> (the shorter of the session's lifetime unused and its cookie's, as this server runs): nothing here goes past it, and a time set before it was shortened is cut to it. A device kept above has that time whatever is set here.</p>
  <form class="as-person" method="post" action="<?= $h($this->url('admin/active-sessions', ['action' => 'person'])) ?>">
    <?= $csrf ?>
    <select name="user" required aria-label="Person"><option value="">Choose a person…</option>
      <?php foreach ($persons as $u): ?><option value="<?= (int) $u['id'] ?>"><?= $h($u['name'] . ' · ' . $u['email'] . ' · ' . str_replace('_', ' ', $u['role']) . (isset($choices[(int) $u['id']]) ? ' · now ' . Limits::choiceWords($choices[(int) $u['id']], $ceiling) : '')) ?></option><?php endforeach; ?>
    </select>
    <select name="limit" aria-label="Sign-in lasts">
      <option value="role">As their role (the rule above)</option>
      <?php foreach (Limits::offered($ceiling) as $k): ?>
      <option value="<?= $h($k) ?>"><?= $h($k === 'max' ? 'Longest the server allows (' . Limits::words($ceiling) . ')' : Limits::words(Limits::CHOICES[$k])) ?></option>
      <?php endforeach; ?>
    </select>
    <button type="submit">Set</button>
  </form>
  <?php if ($choices): ?>
  <table class="as-table" style="margin-top:10px">
    <thead><tr><th>Person</th><th>Sign-ins last</th><th></th></tr></thead>
    <tbody>
    <?php foreach ($choices as $cuid => $c): ?>
      <tr>
        <td data-l="Person"><?= $who((int) $cuid) ?></td>
        <td data-l="Sign-ins last"><?= $h(Limits::choiceWords($c, $ceiling)) ?></td>
        <td class="as-act">
          <form method="post" action="<?= $h($this->url('admin/active-sessions', ['action' => 'person'])) ?>"><?= $csrf ?>
            <input type="hidden" name="user" value="<?= (int) $cuid ?>"><input type="hidden" name="limit" value="role">
            <button type="submit">As their role again</button></form>
          <form class="as-end" method="post" action="<?= $h($this->url('admin/active-sessions', ['action' => 'end-all'])) ?>"
                onsubmit="return confirm(<?= $h(json_encode('Sign out ' . ($users[(int) $cuid]['name'] ?? 'this person') . ' on every device?')) ?>)"><?= $csrf ?>
            <input type="hidden" name="user" value="<?= (int) $cuid ?>"><button type="submit">Sign out on every device</button></form>
        </td>
      </tr>
    <?php endforeach; ?>
    </tbody>
  </table>
  <?php endif; ?>
  <?php $many = []; foreach ($rows as $r) { if (!$r['mine']) { $many[(int) $r['session']['user_id']] = ($many[(int) $r['session']['user_id']] ?? 0) + 1; } } ?>
  <?php if ($many): ?>
  <form class="as-person as-end" style="margin-top:10px" method="post" action="<?= $h($this->url('admin/active-sessions', ['action' => 'end-all'])) ?>"
        onsubmit="return confirm('Sign out this person on every device, kept ones too?')">
    <?= $csrf ?>
    <select name="user" required aria-label="Person"><option value="">Sign out one person everywhere…</option>
      <?php foreach ($many as $muid => $n): ?><option value="<?= (int) $muid ?>"><?= $h(($users[$muid]['name'] ?? '#' . $muid) . ' · ' . $n . ' sign-in' . ($n === 1 ? '' : 's')) ?></option><?php endforeach; ?>
    </select>
    <button type="submit">Sign out on every device</button>
  </form>
  <?php endif; ?>
</div>

<div class="as-box">
  <h3>Changes to sign-in times</h3>
  <?php if (!$log): ?>
    <p class="as-mute">None.</p>
  <?php else: ?>
  <ul class="as-mute">
    <?php foreach ($log as $l): ?>
      <li><?= $h($at((int) $l['at'])) ?> · <?= $h($users[(int) $l['user']]['name'] ?? ('#' . $l['user'])) ?> · <?= $h($l['what']) ?> · <?= $h((int) $l['by'] === 0 ? 'the rule' : ($users[(int) $l['by']]['name'] ?? ('#' . $l['by']))) ?></li>
    <?php endforeach; ?>
  </ul>
  <?php endif; ?>
</div>

<div class="as-box">
  <h3>Ended from this page (last 30 days)</h3>
  <?php if (!$ended): ?>
    <p class="as-mute">None.</p>
  <?php else: ?>
  <table class="as-table">
    <thead><tr><th>When</th><th>Who was signed out</th><th>Device</th><th>Address</th><th>By</th></tr></thead>
    <tbody>
    <?php foreach ($ended as $e): ?>
      <tr>
        <td data-l="When"><?= $h($at((int) $e['ended'])) ?></td>
        <td data-l="Who"><?= $h($users[(int) $e['user_id']]['name'] ?? ('#' . $e['user_id'])) ?></td>
        <td data-l="Device"><?= $e['user_agent'] !== '' ? '<span title="' . $h($e['user_agent']) . '">' . $h(Device::describe($e['user_agent'])) . '</span>' : '<span class="as-mute">not seen</span>' ?></td>
        <td data-l="Address"><?= $e['ip'] !== '' ? '<code>' . $h($e['ip']) . '</code>' : '<span class="as-mute">not seen</span>' ?></td>
        <td data-l="By"><?= $h((int) $e['ended_by'] === 0 ? 'Time limit' : ($users[(int) $e['ended_by']]['name'] ?? ('#' . $e['ended_by']))) ?></td>
      </tr>
    <?php endforeach; ?>
    </tbody>
  </table>
  <?php endif; ?>
</div>
